# ─────────────────────────────────────────────────────────────────────────────
# Elfura — RESOLVER NODE (source discovery)
#
# This box does the expensive work: it talks to all the providers, decodes their
# responses, verifies manifests, and hands back stream candidates. It serves no
# UI and no video segments.
#
# Start it with:  node index.js --resolver
#
# Pterodactyl note: the panel's start command decides whether --resolver is
# passed. If the panel only runs `node index.js`, this node starts a MEDIA
# server on 3003 instead of a resolver — it will look alive and do nothing the
# streaming node wants. Set ELFURA_RESOLVER_MODE=1 as well, and confirm the boot
# log says "[elfura-resolver]", not "[elfura-backend]".
# ─────────────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
NODE_ENV=production

# Must be byte-identical on both nodes (see STREAMING.env).
ELFURA_SECRET=8KzP2wV9mQxLr4tY1bNhJ6sWdF3pXvC5gKjL8mZ2qXvN4wR7tY1bNhJ6sWdF3pXv

# ── resolver role ───────────────────────────────────────────────────────────
ELFURA_RESOLVER_MODE=1
# The resolver reads ONLY this variable for its port — SERVER_PORT is ignored in
# resolver mode. Must match the port in STREAMING.env's ELFURA_RESOLVER_URL.
ELFURA_RESOLVER_PORT=3003
# Required for a two-machine setup: the default is 127.0.0.1, which is
# unreachable from the other box. This prints a warning on boot by design —
# firewall this port to the streaming node's IP so discovery is not public.
ELFURA_RESOLVER_LISTEN=0.0.0.0
# Same value as in STREAMING.env.
ELFURA_RESOLVER_TOKEN=change-me-shared-resolver-token

# This node does not serve embeds. Leaving the viewer limit off here costs
# nothing and removes any chance of the resolver refusing a busy media server.
RATE_LIMIT_PER_MIN=0

# ── discovery tuning ────────────────────────────────────────────────────────
# Generous: a slow-but-working provider must not be reported as blocked, and
# the original 9s cut off genuine slow lanes.
RESOLVE_TIMEOUT_MS=25000
RELAY_MODE=hybrid

# ── TMDB ────────────────────────────────────────────────────────────────────
# Kept on /4 to match your existing live config; see the note in STREAMING.env.
TMDB_API_BASE=https://api.themoviedb.org/4
TMDB_API_KEY=944473057acb13a9f84c233b9e3b5178
TMDB_BEARER_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiI5NDQ0NzMwNTdhY2IxM2E5Zjg0YzIzM2I5ZTNiNTE3OCIsIm5iZiI6MTc4Mzc1NTM1Mi42NDksInN1YiI6IjZhNTFmMjU4MjA1NDQ4ZjdmYzU5NWEzMyIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.xhaIdVmD8qlEFp7mhHc0J6q7TDMBFHb3JdtZxeOb7BY
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_TIMEOUT_MS=4500

# ── sources and subtitles ───────────────────────────────────────────────────
# This is the node that actually uses these, so they belong here.
ELFURA_TELUGU_ENABLED=1

OPENSUBTITLES_ENABLED=1
OPENSUBTITLES_BASE=https://opensubtitles-v3.strem.io
OPENSUBTITLES_TIMEOUT_MS=2800
