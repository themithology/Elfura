# ─────────────────────────────────────────────────────────────────────────────
# Elfura — STREAMING NODE (media server)
#
# This box serves the embeds, the catalogue, artwork, and the video segments.
# It does NOT run source discovery: that work is delegated to the resolver node
# in RESOLVER.env, which is the CPU-heavy half.
#
# Start it with the normal panel command:  node index.js
# ─────────────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
# Must match the panel's allocated port for this server.
SERVER_PORT=3002

NODE_ENV=production

# Must be byte-identical on both nodes. Playback tokens and stream tickets are
# signed with this; if the two boxes disagree, every stream fails with a 401 and
# it looks like broken sources rather than a config mismatch.
ELFURA_SECRET=8KzP2wV9mQxLr4tY1bNhJ6sWdF3pXvC5gKjL8mZ2qXvN4wR7tY1bNhJ6sWdF3pXv

ALLOWED_ORIGINS=*
REQUIRE_PLAYBACK_TOKEN=1
BIND_TOKEN_IP=0

# Viewer-facing rate limiting: 0 = off. A large number is equivalent but leaves
# the counter running for nothing, so use 0 to actually disable it.
RATE_LIMIT_PER_MIN=0

RESOLVE_TIMEOUT_MS=25000
RELAY_MODE=hybrid

# ── where the resolver lives ────────────────────────────────────────────────
# Replace 10.0.0.5 with the resolver node's PRIVATE address.
#   127.0.0.1 only works if both processes share a network namespace.
#   A public IP is REFUSED at startup unless ELFURA_RESOLVER_ALLOW_PUBLIC=1,
#   because the token and the source list would travel in clear text.
# If this URL is wrong the media server silently resolves locally instead, so a
# broken split looks identical to a working one that is simply slow.
ELFURA_RESOLVER_URL=http://10.0.0.5:3003
# Same value as ELFURA_RESOLVER_TOKEN in RESOLVER.env. Defaults to ELFURA_SECRET
# if omitted, which is why both files carry the same secret.
ELFURA_RESOLVER_TOKEN=change-me-shared-resolver-token

# ── TMDB ────────────────────────────────────────────────────────────────────
# Kept on /4 as you have always run it. If title metadata ever 404s, /3 is the
# value this client's code paths are shaped for.
TMDB_API_BASE=https://api.themoviedb.org/4
TMDB_API_KEY=944473057acb13a9f84c233b9e3b5178
TMDB_BEARER_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiI5NDQ0NzMwNTdhY2IxM2E5Zjg0YzIzM2I5ZTNiNTE3OCIsIm5iZiI6MTc4Mzc1NTM1Mi42NDksInN1YiI6IjZhNTFmMjU4MjA1NDQ4ZjdmYzU5NWEzMyIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.xhaIdVmD8qlEFp7mhHc0J6q7TDMBFHb3JdtZxeOb7BY
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_TIMEOUT_MS=4500

# ── sources and subtitles ───────────────────────────────────────────────────
# Only used if this node ends up resolving locally (see ELFURA_RESOLVER_URL).
ELFURA_TELUGU_ENABLED=1

OPENSUBTITLES_ENABLED=1
OPENSUBTITLES_BASE=https://opensubtitles-v3.strem.io
OPENSUBTITLES_TIMEOUT_MS=2800
