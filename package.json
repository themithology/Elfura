{
  "name": "elfura-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elfura — a small, fast, embeddable HLS/DASH player with multi-audio, customisable subtitles, and a zero-disk uniform TMDB streaming backend.",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsc -p backend/tsconfig.json --watch",
    "build": "npm run typecheck && npm run build:embed && npm run build:lib && npm run build:backend",
    "build:embed": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:pterodactyl": "npm run build && python3 scripts/build-pterodactyl-zip.py",
    "start": "node index.js",
    "test": "node backend/test/e2e.mjs && node backend/test/roxy.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "npm run typecheck:player && npm run typecheck:backend",
    "typecheck:player": "tsc --noEmit",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dashjs": "^5.1.1",
    "hls.js": "^1.6.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
