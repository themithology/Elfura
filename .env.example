# ============================================================================
# Elfura Backend — the only settings most installs ever need
# ============================================================================
#
# Every source is ON by default. There are no per-source switches to maintain:
# if a source cannot work (missing credentials, region gated) it returns in
# milliseconds and costs nothing. Do not add toggles unless you are debugging.

# Pterodactyl injects SERVER_PORT automatically; PORT is the fallback.
SERVER_PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Optional. Playback tickets are signed with this. If you leave it empty a fresh
# random secret is generated at every boot — playback keeps working, but links
# minted before a restart stop working. Set it once if you want restarts to be
# invisible to viewers:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELFURA_SECRET=

# Comma-separated allowed parent origins ('*' allows any).
ALLOWED_ORIGINS=*

# hybrid = manifests/subtitles/keys and header-locked streams relay through the
#          backend, anonymous CORS-safe media goes straight from the edge CDN.
# full   = everything relays through the backend.
RELAY_MODE=hybrid

# ---------------------------------------------------------------------------
# TMDB — the one thing the app genuinely needs
# ---------------------------------------------------------------------------
# Either a public key (TL;DR: https://www.themoviedb.org/settings/api) ...
TMDB_API_KEY=
# ... or a bearer token, or point TMDB_API_BASE at your own mirror.
# TMDB_API_BASE=
# TMDB_BEARER_TOKEN=
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# TMDB_TIMEOUT_MS=4500

# ---------------------------------------------------------------------------
# Optional extras — leave commented out unless you want them
# ---------------------------------------------------------------------------
# AniVortex anime lane (Source 17). Needs signed installation credentials;
# without them the lane is simply skipped. Mint them with:
#   node scripts/anivortex-register.mjs
# ELFURA_ANIVORTEX_INSTALL_ID=
# ELFURA_ANIVORTEX_KEY_ID=
# ELFURA_ANIVORTEX_PRIVATE_KEY=

# Subtitles fallback (on by default, RAM cached only).
# OPENSUBTITLES_ENABLED=0

# Budget for the FIRST playback response, in ms (default 4600, floor 3000).
# Sources that are still working after it are appended to the list seconds
# later, so raising this only makes the first screen slower.
# ELFURA_RESOLVE_BUDGET_MS=4600

# Pop-under ads inside the embed player only. Never on the catalogue, landing
# page, download page or admin panel; never for localhost/private addresses;
# never for theogpiratebot.online or theogpiratebot.to. Turn them off globally or
# per site in the admin panel (/roxy -> Pop-under ads). Set an empty value to
# disable ads entirely on this install.
# ELFURA_POPUNDER_SRC=https://4xfreedom.com/1/120bbfb2641cdab678b85c4203ea372b

# One console line per resolve with each source's raw/live counts, plus one
# connectivity line per boot. Useful when reporting a missing source.
# ELFURA_DEBUG_SOURCES=1

# Wrong-length filter. Streams whose measured runtime is far from TMDB's runtime
# (±20 min movie, ±5 min episode) are hidden. It stands down automatically if it
# would ever remove every stream; set to 0 to keep every stream unconditionally.
# ELFURA_RUNTIME_GUARD=1

# ---- "why did it stop?" telemetry -------------------------------------------
# GET /api/v1/perf answers with event-loop lag (p50/p99/max + the worst stall and
# what was running), CPU %, cgroup CPU throttling on a container, GC pauses,
# memory, and every rate-limit denial by bucket. /api/v1/health carries a
# one-line verdict: healthy | cpu-throttled | cpu-contended | event-loop-blocked
# | gc-pressure | rate-limited. Stalls are also printed to the console.
# A loop delay above this many ms is logged as a stall (default 250).
# ELFURA_STALL_WARN_MS=250

# Artwork and playback each get their own per-IP window instead of sharing the
# general 120/min budget: a catalogue page plus one stream used to exhaust it,
# answering 429 to both and looking exactly like "every source died".
# Defaults: artwork max(600, 6x base), playback max(180, 3x base).
# ELFURA_ART_RATE_LIMIT=600
# ELFURA_PLAYBACK_RATE_LIMIT=360

# ---- concurrency ceilings (OFF by default) ----------------------------------
# Nothing is queued unless you ask for it: the box has headroom, and a ceiling
# here is a throughput ceiling for the whole site. Only switch these on for a
# genuinely small container — every resolve beyond the limit is a request that
# gets 503 and a viewer who sees no sources.
# ELFURA_RESOLVE_CONCURRENCY=0   # 0 = unlimited; e.g. 32 to cap running resolves
# ELFURA_RESOLVE_QUEUE=24        # callers allowed to wait when the cap is on
# ELFURA_RESOLVE_QUEUE_MS=6000   # how long a waiter may wait
# ELFURA_RESOLVE_PER_IP=0        # 0 = unlimited; e.g. 8 to cap one client

# Rate ceilings for page-load traffic are also OFF by default (0 = unlimited).
# Abuse-sensitive endpoints (login, admin, diagnostics) keep their own limits.
# ELFURA_ART_RATE_LIMIT=0
# ELFURA_PLAYBACK_RATE_LIMIT=0

# ---- using more than one core -------------------------------------------------
# Node runs your JavaScript on one thread, so one process cannot use more than
# one core however many the box has. Setting ELFURA_WORKERS=N runs the same
# server in N processes behind the same port: N event loops, so N times the
# concurrent resolves before the loop starts stalling. Memory grows with the
# worker count (each has its own caches), so start at 2 and watch RSS.
# ELFURA_WORKERS=1               # 1 = the single-process server (default)
# Each worker has its own caches, so RSS roughly doubles per worker. With the
# memory you have, 1 is the safe default; only raise it if RSS has room.

# ---- memory: how many upstream probes may run at once ------------------------
# Manifest probes all share one process-wide pool, so a hundred concurrent
# resolves cannot hold thousands of HTTP responses (and their buffered playlists)
# in memory at the same time. This is not a request limit: nothing is refused,
# resolves queue for a slot and finish. Lower it if RSS still climbs; raise it if
# the box is mostly idle and you want faster verification.
# ELFURA_PROBE_PARALLELISM=32
