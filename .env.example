# ============================================================================
# Elfura Backend — Environment Configuration (Pterodactyl + Cloudflare)
# ============================================================================

# Pterodactyl injects SERVER_PORT automatically; PORT is used as fallback.
SERVER_PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Strong random secret for HMAC playback tokens + AES-256-GCM stream tickets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELFURA_SECRET=replace-with-a-64-char-random-hex-secret

# Comma-separated allowed parent/embed origins ('*' allows all origins).
ALLOWED_ORIGINS=*

# Anti-scraper session enforcement (1 = require signed pltoken, 0 = disable)
REQUIRE_PLAYBACK_TOKEN=1
BIND_TOKEN_IP=0
RATE_LIMIT_PER_MIN=120
RESOLVE_TIMEOUT_MS=9000

# Stream relay mode:
#   hybrid = Cloudflare-safe smart offload (manifests/subs/keys + header-locked or
#            source-identifying streams relay through backend; verified anonymous
#            CORS-safe HTTPS media segments stream directly from edge CDNs).
#   full   = Pipe 100% of manifests and binary video segments through backend.
RELAY_MODE=hybrid

# Self-hosted TMDB API (used for title, poster, backdrop, episode info & IMDb ID)
# Example: https://tmdb.yourdomain.com/3  or  https://tmdb.yourdomain.com/api
TMDB_API_BASE=
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_TIMEOUT_MS=4500

# Source adapter toggles (1 = enabled, 0 = disabled)
SOURCE1_ENABLED=1
# Source 2 now shares SOURCE1_ENABLED and uses VidRift and VidRock.
# Legacy SOURCE2 settings (VidStuck/Nxsha) are ignored.
SOURCE3_ENABLED=1

# Source 3 (VidSync Pro) API origin
SOURCE3_ORIGIN=https://vidsync.pro

# Automatic OpenSubtitles fallback (zero-disk RAM cache, sealed via /api/v1/stream)
OPENSUBTITLES_ENABLED=1
OPENSUBTITLES_BASE=https://opensubtitles-v3.strem.io
OPENSUBTITLES_TIMEOUT_MS=2800
