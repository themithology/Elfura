# ============================================================================
# Elfura backend — four approved sources, native Node networking
# ============================================================================
# The active manifest is source-1 (Citadel/RiveStream), source-2 (Greybox),
# source-3 (Nxsha), and source-4 (Vidly). All are enabled by default. Each
# adapter uses Node's native fetch; the Vidly media relay uses a direct guarded
# HTTP transport so media URLs cannot escape their measured origin.

# Pterodactyl injects SERVER_PORT automatically; PORT is the fallback.
SERVER_PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Optional. If unset, a new per-boot secret is generated; old playback tickets
# will no longer work after restart. Set one stable secret for persistent tickets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELFURA_SECRET=

# Comma-separated allowed parent origins ('*' allows any).
ALLOWED_ORIGINS=*

# Playback media delivery only (not source discovery):
# hybrid = manifests, subtitles, keys and protected streams relay through
#          /api/v1/stream; verified anonymous CORS-safe media may use the CDN.
# full   = all media also passes through /api/v1/stream.
RELAY_MODE=hybrid

# ---------------------------------------------------------------------------
# TMDB — metadata/catalogue
# ---------------------------------------------------------------------------
TMDB_API_KEY=
# TMDB_API_BASE=https://your-tmdb-mirror.example
# TMDB_BEARER_TOKEN=
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# TMDB_TIMEOUT_MS=4500

# ---------------------------------------------------------------------------
# Four active source adapters
# ---------------------------------------------------------------------------
# All default to enabled. Set an adapter's flag to 0 only to disable it.
# ELFURA_CITADEL_ENABLED=0
# ELFURA_GREYBOX_ENABLED=0
# ELFURA_NXSHA_ENABLED=0
# ELFURA_VIDLY_ENABLED=0
# Optional origin/API overrides; leave unset to use measured defaults.
# ELFURA_CITADEL_API=https://scrapper.rivestream.app/api/provider
# ELFURA_GREYBOX_ORIGIN=https://greyboxtv.duckdns.org
# ELFURA_NXSHA_ORIGIN=https://nxsha.space
# ELFURA_VIDLY_ORIGIN=https://vidly.pro

# ---------------------------------------------------------------------------
# Optional application features
# ---------------------------------------------------------------------------
# Subtitles fallback (on by default, RAM cached only).
# OPENSUBTITLES_ENABLED=0
# OPENSUBTITLES_BASE=https://opensubtitles-v3.strem.io
# OPENSUBTITLES_TIMEOUT_MS=2800

# Budget for the first playback response. Later results can join the active list.
# ELFURA_RESOLVE_BUDGET_MS=4600
# RESOLVE_TIMEOUT_MS=9000
# ELFURA_DEBUG_SOURCES=1
# ELFURA_VERBOSE_SOURCES=1

# Pop-under ads appear in the embed player only. Manage global/site settings in
# /roxy, or set an empty value here to disable the configured ad source.
# ELFURA_POPUNDER_SRC=https://example.invalid/ad

# Optional whole-site redirect. API and Roxy routes remain on the current host;
# embedded player navigations are not redirected.
# ELFURA_REDIRECT_TO=player.example.com

# Payload caches are bounded in RAM and enabled by default.
# ELFURA_RAM_CACHE=off
# Viewer rate limiting is off by default; set a positive requests/minute cap.
# RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------------------
# Optional separate source resolver
# ---------------------------------------------------------------------------
# The same build can run in one process or with a private resolver process/node.
# The media stream relay and tickets remain on the media server. Leave all
# resolver settings unset for the simplest single-process installation.
# ELFURA_RESOLVER_URL=http://10.0.0.5:8790
# ELFURA_RESOLVER_TOKEN=use-a-secret-shared-by-both-nodes
# ELFURA_RESOLVER_ALLOW_PUBLIC=0
# ELFURA_RESOLVER_ALLOW_LOCAL=1
# ELFURA_RESOLVER_AUTOSTART=1
# ELFURA_RESOLVER_BACKUP_URL=
# ELFURA_RESOLVER_THIRD_URL=
# ELFURA_RESOLVER_FOURTH_URL=
# ELFURA_RESOLVER_LISTEN=127.0.0.1
# ELFURA_RESOLVER_PORT=8787
# ELFURA_RESOLVER_OPEN=0
# ELFURA_RESOLVER_VERBOSE=0

# Keep real secrets in the server environment or its private .env; never commit
# them or include the root .env in a deployment archive.
