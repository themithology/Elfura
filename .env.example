# ============================================================================
# Elfura Backend — Environment Configuration (Pterodactyl + Cloudflare)
# ============================================================================

# Pterodactyl injects SERVER_PORT automatically; PORT is used as fallback.
SERVER_PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Strong random secret for HMAC playback tokens + AES-256-GCM stream tickets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELFURA_SECRET=replace-with-a-64-char-random-hex-secret

# Comma-separated allowed parent/embed origins ('*' allows all origins).
ALLOWED_ORIGINS=*

# Anti-scraper session enforcement (1 = require signed pltoken, 0 = disable)
REQUIRE_PLAYBACK_TOKEN=1
BIND_TOKEN_IP=0
RATE_LIMIT_PER_MIN=120
RESOLVE_TIMEOUT_MS=9000

# Stream relay mode:
#   hybrid = Cloudflare-safe smart offload (manifests/subs/keys + header-locked or
#            source-identifying streams relay through backend; verified anonymous
#            CORS-safe HTTPS media segments stream directly from edge CDNs).
#   full   = Pipe 100% of manifests and binary video segments through backend.
RELAY_MODE=hybrid

# Self-hosted TMDB API (used for title, poster, backdrop, episode info & IMDb ID)
# Example: https://tmdb.yourdomain.com/3  or  https://tmdb.yourdomain.com/api
TMDB_API_BASE=
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_TIMEOUT_MS=4500

# Source adapter toggles (1 = enabled, 0 = disabled)
SOURCE1_ENABLED=1
SOURCE2_ENABLED=1

# --- Per-pipeline overrides (all optional) ---------------------------------
# Leave these EMPTY unless a provider publishes a new route. An empty value
# disables that pipeline outright instead of burning a socket + timeout on
# every single resolve against a dead endpoint.
#
# SOURCE1_API_ORIGIN   public JSON hub  (/api/m/:id, /api/tv/:id/:s/:e)
#                      Upstream retired this — every route answers 404 today.
# SOURCE1_RIFT_ORIGIN  Rift/Orion boot  (/api/boot/...)
# SOURCE1_RIFT_RELAY   relay used to unwrap Rift manifests
SOURCE1_API_ORIGIN=
SOURCE1_RIFT_ORIGIN=
SOURCE1_RIFT_RELAY=

# Live, verified pipelines (defaults shown — override only if a host moves):
# SOURCE1_APP_ORIGIN=https://tgvid.lovable.app
# SOURCE1_SYNC_ORIGIN=https://vidsync.pro
# SOURCE1_VIDLINK_ORIGIN=https://vidlink.pro
# SOURCE1_ENCDEC_ORIGIN=https://enc-dec.app
# SOURCE1_VIDROCK_ORIGIN=https://vidrock.net
#
# SOURCE2_EMBED_ORIGIN /api/extract — upstream route retired (404).
# Leave empty to skip it; nxsha + vidstuck keep Source 2 alive either way.
SOURCE2_EMBED_ORIGIN=
# SOURCE2_NXSHA_ORIGIN=https://nxsha.space
# SOURCE2_VIDSTUCK_ORIGIN=https://vidstuck.cc

# Automatic OpenSubtitles fallback (zero-disk RAM cache, sealed via /api/v1/stream)
OPENSUBTITLES_ENABLED=1
OPENSUBTITLES_BASE=https://opensubtitles-v3.strem.io
OPENSUBTITLES_TIMEOUT_MS=2800

