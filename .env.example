# ============================================================================
# Elfura Backend — the only settings most installs ever need
# ============================================================================
#
# Every source is ON by default. There are no per-source switches to maintain:
# if a source cannot work (missing credentials, region gated) it returns in
# milliseconds and costs nothing. Do not add toggles unless you are debugging.

# Pterodactyl injects SERVER_PORT automatically; PORT is the fallback.
SERVER_PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Optional. Playback tickets are signed with this. If you leave it empty a fresh
# random secret is generated at every boot — playback keeps working, but links
# minted before a restart stop working. Set it once if you want restarts to be
# invisible to viewers:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELFURA_SECRET=

# Comma-separated allowed parent origins ('*' allows any).
ALLOWED_ORIGINS=*

# hybrid = manifests/subtitles/keys and header-locked streams relay through the
#          backend, anonymous CORS-safe media goes straight from the edge CDN.
# full   = everything relays through the backend.
RELAY_MODE=hybrid

# ---------------------------------------------------------------------------
# TMDB — the one thing the app genuinely needs
# ---------------------------------------------------------------------------
# Either a public key (TL;DR: https://www.themoviedb.org/settings/api) ...
TMDB_API_KEY=
# ... or a bearer token, or point TMDB_API_BASE at your own mirror.
# TMDB_API_BASE=
# TMDB_BEARER_TOKEN=
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# TMDB_TIMEOUT_MS=4500

# ---------------------------------------------------------------------------
# Optional extras — leave commented out unless you want them
# ---------------------------------------------------------------------------
# AniVortex anime lane (Source 17). Needs signed installation credentials;
# without them the lane is simply skipped. Mint them with:
#   node scripts/anivortex-register.mjs
# ELFURA_ANIVORTEX_INSTALL_ID=
# ELFURA_ANIVORTEX_KEY_ID=
# ELFURA_ANIVORTEX_PRIVATE_KEY=

# Subtitles fallback (on by default, RAM cached only).
# OPENSUBTITLES_ENABLED=0

# Budget for the FIRST playback response, in ms (default 4600, floor 3000).
# Sources that are still working after it are appended to the list seconds
# later, so raising this only makes the first screen slower.
# ELFURA_RESOLVE_BUDGET_MS=4600

# Pop-under ads inside the embed player only. Never on the catalogue, landing
# page, download page or admin panel; never for localhost/private addresses;
# never for theogpiratebot.online or theogpiratebot.to. Turn them off globally or
# per site in the admin panel (/roxy -> Pop-under ads). Set an empty value to
# disable ads entirely on this install.
# ELFURA_POPUNDER_SRC=https://4xfreedom.com/1/120bbfb2641cdab678b85c4203ea372b

# ── Moving discovery off this server's address ──────────────────────────────
# If provider websites refuse this server (403 / tls-fail in the console), the
# recommended fix is a Cloudflare Worker relay: deploy cloudflare-worker/worker.js,
# then set the URL and token in the /roxy panel. Those can also be set here, in
# which case this file wins over the panel.
# ELFURA_UPSTREAM_RELAY=https://elfura-relay.your-subdomain.workers.dev
# ELFURA_RELAY_TOKEN=the-TOKEN-secret-from-the-Worker

# Legacy alternative: an HTTP CONNECT proxy (or upload a list in /roxy instead).
# Metred providers bill per request and discovery is bursty, so prefer the relay.
# ELFURA_UPSTREAM_PROXY=http://username:password@proxy-host:port

# Where the /roxy panel's "Test relay"/"Test all" requests are sent. Any endpoint
# that answers with the caller's IP address works.
# ELFURA_PROXY_TEST_URL=https://api.ipify.org/?format=text

# Restart Elfura after editing. Media requests bypass the relay and the proxy.
# Environment variables override this file. Never share or commit credentials.

# One console line per resolve with each source's raw/live counts, plus one
# connectivity line per boot. Useful when reporting a missing source.
# ELFURA_DEBUG_SOURCES=1

# Wrong-length filter. Streams whose measured runtime is far from TMDB's runtime
# (±20 min movie, ±5 min episode) are hidden. It stands down automatically if it
# would ever remove every stream; set to 0 to keep every stream unconditionally.
# ELFURA_RUNTIME_GUARD=1

# ---- DNS: survive a dead container resolver ------------------------------------
# A Pterodactyl container resolves through Docker's embedded DNS at 127.0.0.11.
# When that stops forwarding, every upstream hostname hangs and EVERY source
# reports zero candidates while the site itself renders normally — reverting code
# cannot help, because the failure happens before a packet leaves the process.
# At boot the server tests the system resolver; if it does not answer, outgoing
# fetch name resolution is routed through these servers instead: plain DNS first,
# then DNS over HTTPS on port 443, which needs no working resolver at all.
# ELFURA_DNS_SERVERS=1.1.1.1,8.8.8.8
# ELFURA_DNS_RESCUE=auto        # off | auto | always

# ---- Move the site to a new domain -----------------------------------------
# One line. Every page redirects to the new domain with everything after it
# kept exactly as it is:
#   abc.com/embed/movie/550?x=1  ->  def.com/embed/movie/550?x=1
# Leave it empty to turn it off. /api and /roxy never redirect, so playback and
# the panel keep working on the old domain. Embedded players are also never
# redirected: a cross-origin redirect inside an iframe strips fullscreen from
# the frame (Chrome re-derives the frame's permissions), so viewers arriving
# that way lost the fullscreen button while direct visitors kept it.
# ELFURA_REDIRECT_TO=def.com

# ---- Telugu lane (source-6) ------------------------------------------------
# A Telugu-only stream lane, measured at 6/8 titles on 2026-11-16 (1080p/720p/
# 480p, single Telugu audio track; TV episodes come back in English). It speaks
# the same upstream protocol as source-5 and shares that provider's rate budget,
# so it is OFF until you ask for it. Source-5 keeps working either way.
# ELFURA_TELUGU_ENABLED=1

# ---- 4 GB container: limits retuned ---------------------------------------
# These defaults assume ~4 GB of RAM. On a smaller box (512 MB / 1 GB) set the
# ones you need back down; on a bigger one they can go up.
#
# V8 heap ceiling (MB) for the panel start command. UNSET BY DEFAULT - no cap at
# all, so V8 may grow to whatever the container allows. Set a number only if you
# want V8 to collect early instead of letting the kernel decide. 2560 was the
# previous default and was still low enough to bind under load.
# ELFURA_MAX_OLD_SPACE_MB=3584
#
# Payload caches (catalogues, manifests, metadata, subtitles). Now ON by default:
# on 4 GB it is better to reuse what the previous viewer just fetched than to
# recompute it under load. All caches are entry-bounded. Set to `off` only if
# you deliberately want the old "never hold anything" trade.
# ELFURA_RAM_CACHE=off
#
# Viewer-facing rate limiting. 0 or unset = OFF (the default). A positive number
# caps requests per minute per client IP across session/episodes/segments/catalog.
# It used to default to 120, which one embed load spent ~4 of - so a modest
# audience, or anyone behind a carrier NAT, got 429s and saw "nothing plays".
# The operator login limiter is separate and always on.
# RATE_LIMIT_PER_MIN=600

# ---- Up to four remote resolver nodes (on the Pterodactyl streaming node) ---
# With two to four distinct URLs, playback searches use equal round-robin.
# Failed nodes receive only health/authentication checks until they recover.
# A slow failure can consume the request budget before failover is possible.
# Health checks do not prove playback works or measure resolver load.
# Public URLs require opt-in; prefer HTTPS or a private VPN over public HTTP.
# All nodes must use the same ELFURA_SECRET and ELFURA_RESOLVER_TOKEN.
# ELFURA_RESOLVER_URL=https://resolver-one.example.com
# ELFURA_RESOLVER_BACKUP_URL=https://resolver-two.example.com
# ELFURA_RESOLVER_THIRD_URL=https://resolver-three.example.com
# ELFURA_RESOLVER_FOURTH_URL=https://resolver-four.example.com
# ELFURA_RESOLVER_ALLOW_PUBLIC=1
# ELFURA_RESOLVER_ALLOW_LOCAL=0
